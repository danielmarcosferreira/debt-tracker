rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own profile (name, currency, theme preference).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cards belong to exactly one owner. Only the owner can see or edit them.
    match /cards/{cardId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
    }

    // People are contacts owned by one user, but a person can be "linked" to
    // their own account (linkedUserId) so they can view what they owe.
    match /people/{personId} {
      // Read access also covers an invitee looking up their own pending
      // invite by email (see claimPendingInvites in auth-context.tsx) — the
      // query filters on inviteEmail, so the rule must be provable from that
      // same field, not just from ownerId/linkedUserId.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.uid == resource.data.linkedUserId
            || request.auth.token.email == resource.data.inviteEmail);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // The owner can update anything. A not-yet-linked invitee whose email
      // matches the invite can claim the record by setting linkedUserId to
      // their own uid, and nothing else.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || (
          resource.data.linkedUserId == null
          && resource.data.inviteEmail != null
          && request.auth.token.email == resource.data.inviteEmail
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUserId'])
          && request.resource.data.linkedUserId == request.auth.uid
        )
      );
    }

    // Expenses are owned and fully managed by the owner. A linked person can
    // only read the expenses assigned to them (via the denormalized
    // linkedUserId, kept in sync by the owner's client when a person links).
    match /expenses/{expenseId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.uid == resource.data.linkedUserId);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }
  }
}
